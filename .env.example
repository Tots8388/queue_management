# Environment variables for the Digital Queue & Patient-Flow Management System.
#
# This file lists variable NAMES ONLY. It contains no real credentials and never
# will. Copy it to `.env` (git-ignored) and fill in local values, or set these in
# the host machine's environment / secrets store for the LAN deployment.
#
#   cp .env.example .env
#
# Generate a Django secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# Required. Signing key for sessions and CSRF. Never reuse across environments.
DJANGO_SECRET_KEY=
# development | production. Controls DEBUG and strict startup checks.
DJANGO_ENV=development
# Comma-separated hostnames/IPs the backend will serve. For the clinic LAN this
# is the server's LAN IP, e.g. 192.168.1.50,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Required. If unset in development the backend falls back to local SQLite,
# which is prototype scaffolding only and not acceptable for the pilot or any
# real data (see docs/development.md). Unset in production is a startup error.
DATABASE_URL=
#
# The rest of this block configures the containerised development database in
# deploy/docker-compose.yml, for machines with no local PostgreSQL install:
#
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d
#
# Keep them consistent with DATABASE_URL above. Leave them unset on a machine
# running PostgreSQL natively — the clinic server does, and start.bat reads
# POSTGRES_PASSWORD to decide whether a container is this machine's database.
POSTGRES_DB=queue_management
POSTGRES_USER=queue_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Authentication (JWT — djangorestframework-simplejwt)
# ---------------------------------------------------------------------------
# Optional. Signing key for access/refresh tokens. Falls back to
# DJANGO_SECRET_KEY when unset; set it separately so auth keys can be rotated
# without invalidating sessions.
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=
JWT_REFRESH_TOKEN_LIFETIME_DAYS=

# ---------------------------------------------------------------------------
# Real-time (Django Channels)
# ---------------------------------------------------------------------------
# redis://HOST:PORT/DB — required for the LAN deployment (multi-process).
# Unset in development uses the in-memory channel layer (single process only).
REDIS_URL=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Where the browser reaches the backend. On the clinic LAN use the server's LAN
# IP, not localhost, so staff terminals and display screens can connect.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WS_BASE_URL=
# Comma-separated origins allowed to call the API (staff terminals, displays).
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Hosting (local / on-premise LAN — no cloud in v1)
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Two frontends on two ports. Patients and the waiting-room screen are given
# PATIENT_PORT; only staff terminals are given STAFF_PORT. In development these
# are also what the API's CORS allowlist is built from.
PATIENT_PORT=3000
STAFF_PORT=3001

# ---------------------------------------------------------------------------
# Prototype tooling (development only)
# ---------------------------------------------------------------------------
# The fictional seed accounts' password, printed by `manage.py seed_demo`. Read
# by frontend/scripts/capture-screenshots.mjs so the value is not committed a
# second time. Never set this on a machine holding real data.
DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# SMS / phone notifications (OPTIONAL channel — FR11)
# ---------------------------------------------------------------------------
# The ONLY component that needs outbound internet. The core queue must work
# fully with SMS disabled. Leave SMS_ENABLED false until a provider is confirmed.
SMS_ENABLED=false
# africastalking | twilio | console (logs instead of sending) | disabled
SMS_PROVIDER=africastalking
# Seconds to wait on the gateway before giving up on a message.
SMS_TIMEOUT_SECONDS=8
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_USERNAME=

# ---------------------------------------------------------------------------
# Visit tokens
# ---------------------------------------------------------------------------
# Tokens are drawn at random — one letter, then digits, e.g. K492. Random
# rather than sequential because the waiting-room board publishes every token
# in the building, and a sequence would publish arrival order and the day's
# running total along with it. See docs/design/tracking-board.md.
#
# The alphabet leaves out O, I, L and S: a token is read off a wall screen and
# then said out loud at a desk, and those are the letters that fail at both.
TOKEN_ALPHABET=ABCDEFGHJKMNPQRTUVWXYZ
# Widen this if a period's pool ever runs short. 3 gives 22,000 tokens.
TOKEN_DIGITS=3
# Days a token is reserved for. A visit ends when pharmacy is finished, not
# when the day is, so uniqueness is scoped to a period rather than a day.
# Set to 1 for the old daily behaviour.
TOKEN_PERIOD_DAYS=7

# ---------------------------------------------------------------------------
# Abandoned visits
# ---------------------------------------------------------------------------
# Hours of no activity after which reception may close a visit as abandoned.
# A visit ends when pharmacy is finished, not when the day is, so a patient who
# goes home halfway has nothing to close them; this is the clinic's answer.
# Measured from the visit's last activity, not from check-in. Enforced on the
# server: below this, the close is refused.
STALE_VISIT_HOURS=24

# ---------------------------------------------------------------------------
# Wait-range calculation (spec: cautious range, never a countdown)
# ---------------------------------------------------------------------------
# Number of recent completed services per stage used for the rolling median.
WAIT_RANGE_SAMPLE_SIZE=20
# Minimum completed services required before a range is shown at all; below
# this the patient view shows "wait time unavailable".
WAIT_RANGE_MIN_SAMPLES=5
# Buffer applied either side of the base estimate, as a percentage.
WAIT_RANGE_BUFFER_PERCENT=30

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Directory for local database backups on the clinic machine.
BACKUP_DIR=
# Days to retain audit log entries (spec proposes ~12 months, pending sign-off).
AUDIT_RETENTION_DAYS=
