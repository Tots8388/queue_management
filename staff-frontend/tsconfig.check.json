// Typechecking for `npm run typecheck`, separate from the config the editor and
// `next build` use.
//
// It deliberately drops `.next/types/**` and `**/*.mts` from the include list:
// those are generated by a build, so checking them would mean a clean checkout
// could not be typechecked without building first. What is left is this app's
// own source and the shared UI it compiles, which is the thing a check is meant
// to police.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "plugins": []
  },
  "include": [
    "next-env.d.ts",
    "../shared/**/*.json",
    "../shared/ui/**/*.ts",
    "../shared/ui/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["node_modules", ".next"]
}
